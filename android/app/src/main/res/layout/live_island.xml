<?xml version="1.0" encoding="utf-8"?>
<!--
  Пилюля live-островка: компактная капсула в районе выреза камеры.
  Рисуется поверх других приложений через WindowManager (TYPE_APPLICATION_OVERLAY).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_island_root"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:background="@drawable/live_island_background"
    android:elevation="12dp">

    <View
        android:id="@+id/live_island_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/live_island_dot" />

    <TextView
        android:id="@+id/live_island_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
