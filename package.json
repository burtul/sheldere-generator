{
  "name": "Мой график",
  "version": "0.7.33",
  "private": true,
  "scripts": {
    "build": "node -e \"let pkg=require('./package.json'); let v=pkg.version.split('.'); v[2]++; pkg.version=v.join('.'); require('fs').writeFileSync('package.json', JSON.stringify(pkg,null,2)); console.log('✅ Версия:', pkg.version)\" && next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "export": "next build && next export",
    "android:check": "node scripts/check-requirements.js",
    "android:init": "node scripts/init-android.js",
    "android:fix": "node scripts/fix-gradle.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run export && npx cap sync android",
    "android:run": "npm run android:build && npx cap run android"
  },
